{
    "compilerOptions": {
        "target": "ES2018",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": [
            "DOM",
            "ES2018"
        ],
        "jsx": "react",
        "declaration": true,
        "emitDeclarationOnly": false,
        "outDir": "dist/.tsbuild",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "src"
    ]
}