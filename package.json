{
  "name": "@fluxpay-widget/sdk",
  "version": "0.1.0",
  "description": "Drop-in Solana checkout widget — accept SOL, USDC, and USDT with wallet connect and QR code support",
  "license": "MIT",
  "author": "FluxPay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cypher-CP0/fluxpay-widget.git"
  },
  "homepage": "https://fluxpay.io",
  "keywords": [
    "solana",
    "payments",
    "crypto",
    "checkout",
    "usdc",
    "web3",
    "wallet-adapter"
  ],
  "main": "dist/fluxpay.js",
  "module": "dist/fluxpay.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/fluxpay.esm.js",
      "require": "./dist/fluxpay.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:bundle": "rollup -c rollup.config.js",
    "build:types": "rollup -c rollup.dts.config.js",
    "build": "npm run build:bundle && npm run build:types",
    "dev": "rollup -c rollup.config.js --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.91.1",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.12.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}